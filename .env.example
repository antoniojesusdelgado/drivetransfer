# Public Google web-app identifiers. Restrict the API key to Google Picker API
# and the exact HTTP referrers used by local development and the future host.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
VITE_APPS_SCRIPT_DEPLOYMENT_ID=
# Optional until a dedicated GA4 property exists. Analytics remains disabled
# unless the visitor explicitly accepts it.
VITE_GA_MEASUREMENT_ID=
