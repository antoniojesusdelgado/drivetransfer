{
  "compilerOptions": {
    "target": "ES2020",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.apps-script.tsbuildinfo",
    "module": "none",
    "rootDir": "apps-script/src",
    "lib": ["ES2020"],
    "types": ["google-apps-script"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "ignoreDeprecations": "6.0",
    "noEmitOnError": true,
    "outFile": "apps-script-dist/Code.js"
  },
  "files": [
    "apps-script/src/Types.ts",
    "apps-script/src/Security.ts",
    "apps-script/src/DriveService.ts",
    "apps-script/src/Code.ts"
  ]
}
